# ── Vercel upload exclusions ─────────────────────────────────────────────
# `vercel` (CLI) uploads only the files below. GitHub imports use .gitignore
# instead. Keep these two files in sync.

# dependencies & build output
node_modules/
.next/
out/
build/
tsconfig.tsbuildinfo

# secrets & local databases
.env
.env.local
.env.*.local
prisma/*.db
prisma/*.db-journal
prisma/data/
backups/

# desktop & mobile release binaries — the APK and update manifest ARE served
# from the cloud site (mobile update checker + direct downloads). The 350 MB
# installer stays local-only (Vercel static-file limits); the manifest still
# points at it for LAN installs.
desktop/artifacts/
public/desktop/GES-School-MIS-Setup.exe
public/desktop/GES-School-MIS-Portable.zip

# tooling / scratch
.freebuff/
release/
