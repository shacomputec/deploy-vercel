[TEMPLATE]
# ────────────────────────────────────────────────────────────────────────────
# GES School MIS — environment template
# Copy to `.env` (or set these in your hosting platform) and fill in your own
# values. NEVER commit the real .env file.
# ────────────────────────────────────────────────────────────────────────────

# Database. SQLite (default) works on any VPS with a persistent disk (see
# docker-compose.yml which mounts a volume). For serverless platforms
# (Vercel / Railway / Render) switch to PostgreSQL:
#   provider = "postgresql"  in prisma/schema.prisma, then:
#   DATABASE_URL="postgresql://user:password@host:5432/smis?schema=public"
DATABASE_URL="file:./dev.db"

# Session signing + license signing. Generate strong values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-please"
# Optional separate license-signing secret + old-secret fallback chain (comma separated)
LICENSE_SECRET=""
LICENSE_SECRET_OLD=""
# Optional: encrypts uploaded documents (defaults to JWT_SECRET when empty)
DOCUMENT_ENCRYPTION_KEY=""

# Email (Resend) — used for OTPs, receipts, license keys
RESEND_API_KEY=""
EMAIL_FROM="GES School MIS <onboarding@resend.dev>"

# WhatsApp (Twilio WhatsApp Business API)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_WHATSAPP_FROM=""

# SMS (Hubtel)
SMS_MODE="console"            # console | hubtel
HUBTEL_API_KEY=""
HUBTEL_SENDER_ID=""

# AI assistant (optional)
AI_MODE="off"                 # off | openai
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# First-run seed (unattended installs)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEV_NAME="shacomputec"
SEED_DEV_PHONE="+233530941750"
SEED_DEV_EMAIL="shacomputecgh@gmail.com"

# License trial defaults
SEED_LICENSE_TRIAL_DAYS="30"
SEED_LICENSE_PRICE="500"
SEED_MOMO_ENV="sandbox"       # sandbox | live
SEED_MOMO_BUSINESS_PHONE=""   # e.g. +233 26 666 2501 (receives collections)
SEED_MOMO_SUBSCRIPTION_KEY="" # MTN MoMo developer portal → Subscription → Primary key
SEED_LICENSE_MOMO_PHONES=""   # numbers to pay the license key to (space or / separated)
SEED_PAYSTACK_PUBLIC_KEY=""   # pk_live_… / pk_test_…
SEED_PAYSTACK_SECRET_KEY=""   # sk_live_… / sk_test_… (needed to actually charge)

# After filling the SEED_* payment values above, run:  node scripts/sync-payments.mjs

# Password hashing cost
BCRYPT_ROUNDS="10"

# ── Nightly backups (scripts/backup.mjs) ─────────────────────────────────────
# Where snapshots go (Docker mounts ./backups → /app/backups automatically)
BACKUP_DIR=""
# How many snapshots to keep
BACKUP_KEEP="14"
# Optional cloud upload — set ONE of these, or leave empty for local only:
# BACKUP_RCLONE_REMOTE="gdrive:GES-SMIS-backups"   (install rclone on the host)
# BACKUP_AWS_BUCKET="my-bucket"                     (needs `aws` CLI configured)
# BACKUP_AWS_PREFIX="school-a"
# BACKUP_SCP_TARGET="user@backup-host:/backups/smis"
